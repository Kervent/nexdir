# Copy this file to ".env" (which is ignored by Git) and fill in your values.
# NEVER commit the real .env file, and never paste the token into chats or screenshots.

# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_BOT_TOKEN=your-bot-token-here

# Server ID: Discord → User Settings → Advanced → Developer Mode on,
# then right-click the server icon → Copy Server ID
DISCORD_GUILD_ID=000000000000000000

# Optional: Application ID (General Information page), used to print the invite URL
DISCORD_CLIENT_ID=
