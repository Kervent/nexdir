{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the main Nexdir window. No generic filesystem or shell plugin is exposed; all file access goes through the typed commands below.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:app:default",
    "core:window:default",
    "allow-list-dir",
    "allow-list-drives",
    "allow-known-folders",
    "allow-resolve-path",
    "allow-startup-location",
    "allow-create-folder",
    "allow-rename-entry",
    "allow-recycle-entries",
    "allow-open-path",
    "allow-show-properties",
    "allow-open-url",
    "allow-open-project-url",
    "allow-system-info",
    "allow-find-conflicts",
    "allow-start-operation",
    "allow-cancel-operation",
    "allow-list-operations",
    "allow-operation-report",
    "allow-clipboard-set-files",
    "allow-clipboard-get-files",
    "allow-preview-path",
    "allow-start-storage-scan",
    "allow-start-duplicate-scan",
    "allow-recycle-duplicates",
    "allow-start-search",
    "allow-index-search",
    "allow-cancel-task",
    "allow-task-status",
    "allow-task-result",
    "allow-index-get-settings",
    "allow-index-save-settings",
    "allow-index-status",
    "allow-index-build",
    "allow-index-delete",
    "allow-rules-get",
    "allow-rules-save",
    "allow-organize-preview",
    "allow-organize-apply",
    "allow-confirm-close",
    "allow-update-info",
    "allow-update-ack-last-install",
    "allow-update-save-settings",
    "allow-update-check",
    "allow-update-download",
    "allow-update-cancel",
    "allow-update-snooze",
    "allow-update-install",
    "allow-update-open-release"
  ]
}
