{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexdir",
  "version": "0.6.0-alpha.1",
  "identifier": "org.nexdir.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nexdir",
        "width": 1240,
        "height": 780,
        "minWidth": 720,
        "minHeight": 460,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2NEU5RUY4QzRFNjkwRDIKUldUU2tPYkUrSjVPdG1YVGtuU2ViNkZ4MVVBMmpCS3VpZEdML1lzc2prSWgyOStGZGNsRHl4QTYK",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "msi"],
    "publisher": "Nexdir contributors",
    "copyright": "Copyright (c) Nexdir contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "A smarter way to manage your files.",
    "longDescription": "Nexdir is a modern, intelligent, open-source file manager for Windows.",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "wix": {
        "version": "0.6.0.1",
        "upgradeCode": "0c406486-4175-5369-a3eb-c50750955c8e"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
