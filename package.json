{
  "name": "nexdir",
  "private": true,
  "version": "0.6.0-alpha.1",
  "description": "A modern, intelligent, open-source file manager for Windows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kervent/nexdir.git"
  },
  "homepage": "https://github.com/Kervent/nexdir",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "branding": "node tools/branding/build-branding.mjs && tauri icon assets/branding/png/nexdir-logo-1024.png -o src-tauri/icons"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.24",
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "png-to-ico": "3.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
